# Copy to .env (git-ignored) and fill in the key. Never commit real keys.
#   cp .env.example .env
#
# Any OpenAI-compatible endpoint works. Default below: Groq (free tier).
# Get a key at https://console.groq.com/keys. Keys start with "gsk_".
OPENAI_API_KEY=gsk_your-key-here
OPENAI_BASE_URL=https://api.groq.com/openai/v1
# Must be a model that supports tool (function) calling. Check
# https://console.groq.com/docs/models and copy the exact ID if this one isn't listed.
PAYLANE_MODEL=openai/gpt-oss-120b

# Other providers, for reference:
# OpenAI:    OPENAI_BASE_URL=https://api.openai.com/v1
# xAI Grok:  OPENAI_BASE_URL=https://api.x.ai/v1
# Anthropic: OPENAI_BASE_URL=https://api.anthropic.com/v1/
